{
    "data_path": "data/PREPROCESSED_Reviews.csv",
    "models_dir": "data/models",
    "embedding_dim": 200,
    "max_features": 25000,
    "batch_size": 32,
    "epochs": 20,
    "learning_rate": 0.0005,
    "validation_split": 0.15,
    "max_seq_length": 300,
    "num_classes": 5,
    "random_state": 42,
    "early_stopping_patience": 5,
    "dropout_rate": 0.5,
    "spatial_dropout": 0.4,
    "lstm_hidden_size": 256,
    "lstm_layers": 2,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "label_smoothing": 0.2,
    "use_mixed_precision": true
}
